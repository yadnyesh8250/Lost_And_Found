# Server Configuration
PORT=8000
NODE_ENV=production
CLIENT_URL=https://your-app-name.vercel.app

# Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# Cloud MySQL Database Configuration (Either use DATABASE_URL or individual credentials)
# Option 1: Full Connection String (Recommended for Railway / TiDB / Aiven)
# DATABASE_URL=mysql://username:password@hostname:3306/dbname

# Option 2: Individual Credentials
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campus_sync
DB_USER=root
DB_PASS=your_password
DB_SSL=false

# Cloudinary Configuration (For image/file uploads)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret
